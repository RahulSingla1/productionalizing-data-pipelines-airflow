# Copy to .env and fill in.

# Password the partners use to log in to the app.
APP_PASSWORD=change-me

# Claude API key, used to read the chat (https://console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional
# PORT=3000
# TIME_ZONE=Asia/Kolkata
# RECAP_TIME=22:00          # default time for the daily recap (can be changed in the app)
# EXTRACT_EVERY_MIN=15      # how often new messages are read
# DATE_ORDER=auto           # DMY or MDY for chat exports; auto-detects
# DATA_DIR=./data           # database and WhatsApp login are stored here
# WHATSAPP=off              # disable the WhatsApp bot entirely
