# Copy to .env and fill in. Nothing here is required just to try the app.
KITCHEN_NAME=My Cloud Kitchen
CURRENCY=₹
TIMEZONE=Asia/Kolkata
REMINDER_TIME=20:00
APP_URL=https://your-kitchen-app.example.com
SECRET_KEY=change-me-to-a-long-random-string

# WhatsApp reminders (Twilio) - optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Email reminders - optional (Gmail: smtp.gmail.com, port 587, use an App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
